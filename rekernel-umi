#!/usr/bin/env bash
set -euo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
case ${1:-} in
    --help|-h)
        printf 'Usage: [UMI_KERNEL_VERSION=locked|auto|6.18.x] rekernel-umi MAIN_BOOT_IMG NEW_LINUX_WORK_DIR\n'
        printf '       rekernel-umi query [locked|auto|6.18.x]\n'
        exit 0
        ;;
    query)
        if (($# > 2)); then
            echo 'Usage: rekernel-umi query [locked|auto|6.18.x]' >&2
            exit 2
        fi
        source "$repo/make-fnos/kernel/source.sh"
        resolve_umi_linux "${2:-auto}"
        exit
        ;;
esac
exec bash "$repo/make-fnos/scripts/build-kernel.sh" "$@"

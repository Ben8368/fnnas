# The built-in PM8150B charger needs ADC5 before the root filesystem mounts.
CONFIG_QCOM_SPMI_ADC5=y

# The built-in MSM GPU needs devfreq cooling and its SoC temperature sensors.
CONFIG_DEVFREQ_THERMAL=y
CONFIG_QCOM_TSENS=y

# Register the PM8150 reboot-mode notifier without waiting for a module load.
CONFIG_POWER_RESET_QCOM_PON=y

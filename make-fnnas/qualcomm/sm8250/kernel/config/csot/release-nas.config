# SPDX-License-Identifier: GPL-2.0-only
# Match the native fnOS NFS and OVS services. Keep drivers loadable on demand.
CONFIG_NFSD=m
CONFIG_NFSD_V4=y
CONFIG_OPENVSWITCH=m
# resmon_service reads /proc/<pid>/io while collecting the process list.
CONFIG_TASKSTATS=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y
CONFIG_EXT4_FS=y
CONFIG_EXPORTFS=y
CONFIG_FS_TRIM_ACL=y
CONFIG_TRIMAFS2_FS=y
CONFIG_BLK_DEV_MD=y
CONFIG_MD_DEGRADATION_FREE_RECOVER=y
CONFIG_MD_LLBITMAP=y
# CONFIG_MD_AUTODETECT is not set

# No duplicate drivers for the same hardware. Sink-only research profile.
# CONFIG_BATTERY_QCOM_FG is not set
# CONFIG_CHARGER_QCOM_SMB5 is not set
# CONFIG_CHARGER_BQ25970 is not set
# CONFIG_SUSPEND is not set
CONFIG_BATTERY_MISEED_QCOM_FG=y
CONFIG_CHARGER_MISEED_PM8150B=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_IIO=y
CONFIG_THERMAL_OF=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_QCOM_PMIC=y

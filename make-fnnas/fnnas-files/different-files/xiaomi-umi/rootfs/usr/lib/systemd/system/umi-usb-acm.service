# SPDX-License-Identifier: GPL-2.0-only
[Unit]
Description=Xiaomi Mi 10 fnOS USB setup gadget (NCM and read-only ACM)
Wants=sys-kernel-config.mount umi-usb-network.service umi-usb-bootlog.service
After=systemd-modules-load.service sys-kernel-config.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/umi-usb-acm start
ExecStop=/usr/local/sbin/umi-usb-acm stop
TimeoutStartSec=75s
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target

[Unit]
Description=Xiaomi Mi 10 USB ACM serial console gadget
Wants=sys-kernel-config.mount
After=systemd-modules-load.service sys-kernel-config.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/umi-usb-acm
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target

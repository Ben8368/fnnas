#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
set -euo pipefail

# Native fnOS only. Keep the existing gadget path for orderly restarts.
g=/sys/kernel/config/usb_gadget/umi-acm
c=$g/configs/c.1
acm=$g/functions/acm.usb0
ncm=$g/functions/ncm.usb0
strings=$g/strings/0x409

stop_gadget() {
	[[ -d $g ]] || return 0
	if [[ -n $(< "$g/UDC") ]]; then printf '\n' > "$g/UDC"; fi
	rm -f -- "$c/acm.usb0" "$c/ncm.usb0"
	for node in "$ncm" "$acm" "$c" "$strings" "$g"; do
		if [[ -d $node ]]; then rmdir -- "$node"; fi
	done
}

case ${1:-start} in
	stop) stop_gadget; exit ;;
	start) ;;
	*) exit 2 ;;
esac

if ! mountpoint -q /sys/kernel/config; then
	mount -t configfs configfs /sys/kernel/config
fi
[[ -d /sys/kernel/config/usb_gadget ]] || { echo 'USB configfs gadget support is unavailable' >&2; exit 1; }
shopt -s nullglob
for ((attempt = 0; attempt < 60; attempt++)); do
	udcs=(/sys/class/udc/*)
	if ((${#udcs[@]})); then break; fi
	sleep 1
done
((${#udcs[@]} == 1)) || { echo 'Expected one Umi USB device controller' >&2; exit 1; }

stop_gadget
trap 'rc=$?; if ((rc)); then stop_gadget || true; fi' EXIT
mkdir -p -- "$strings" "$c" "$acm"
printf '0x1d6b\n' > "$g/idVendor"
printf '0xef\n' > "$g/bDeviceClass"
printf '0x02\n' > "$g/bDeviceSubClass"
printf '0x01\n' > "$g/bDeviceProtocol"
printf 'fnOS Umi USB setup\n' > "$strings/product"
printf 'Xiaomi Umi\n' > "$strings/manufacturer"
printf 'umi-log\n' > "$strings/serialnumber"
ln -s -- "$acm" "$c/acm.usb0"

if mkdir -- "$ncm" && printf 'umiusb%%d\n' > "$ncm/ifname" && ln -s -- "$ncm" "$c/ncm.usb0" &&
   printf '0x0103\n' > "$g/idProduct" && printf '%s\n' "${udcs[0]##*/}" > "$g/UDC"; then
	echo 'USB gadget: ACM boot log and NCM network'
else
	# An NCM allocation/bind failure must not hide the diagnostic serial port.
	rm -f -- "$c/ncm.usb0"
	if [[ -d $ncm ]]; then rmdir -- "$ncm"; fi
	printf '0x0104\n' > "$g/idProduct"
	printf '%s\n' "${udcs[0]##*/}" > "$g/UDC"
	echo 'USB gadget: NCM unavailable; ACM boot log only' >&2
fi
